<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Tour Virtual - Camino Real</title>
    <script src="https://aframe.io/releases/1.4.0/aframe.min.js"></script>
    <style>
      /* Estilo del botón de pantalla completa */
      .fullscreen-btn {
        position: absolute;
        bottom: 20px;
        right: 20px;
        z-index: 999;
        background: rgba(0, 0, 0, 0.6);
        color: white;
        border: 2px solid white;
        padding: 10px 15px;
        border-radius: 5px;
        cursor: pointer;
        font-family: sans-serif;
      }
    </style>
  </head>
  <body>

    <button class="fullscreen-btn" onclick="toggleFullScreen()">Pantalla Completa</button>

    <a-scene id="main-scene" embedded>
      
      <a-assets>
        <img id="img_pasillo" src="https://conceptove.github.io/Concepto-Furnitures/Pasillo.png">
        <img id="img_cocina" src="https://conceptove.github.io/Concepto-Furnitures/Cocina.png">
        <img id="img_comedor" src="https://conceptove.github.io/Concepto-Furnitures/Comedor.png">
        <img id="img_sala" src="https://conceptove.github.io/Concepto-Furnitures/Sala.png">

        <img id="Adelante" src="https://conceptove.github.io/Concepto-Furnitures/Arrow_right.png">
        <img id="Atras" src="https://conceptove.github.io/Concepto-Furnitures/Arrow_left.png">
      </a-assets>

      <a-sky id="escena-360" src="#img_pasillo" rotation="0 -90 0"></a-sky>

      <a-camera look-controls="magicWindowTrackingEnabled: true; touchEnabled: true; mouseEnabled: true">
        <a-cursor raycaster="objects: .clickable" cursor="rayOrigin: mouse" visible="false"></a-cursor>
      </a-camera>

      <a-image class="btns-pasillo clickable" src="#Adelante" 
               position="2 1 -3" rotation="-90 0 0" scale="1 1 1"
               onclick="irA('#img_cocina', 'btns-cocina')">
        <a-text value="Ir a Cocina" align="center" position="0 0.8 0" scale="0.5 0.5 0.5"></a-text>
      </a-image>

      <a-image class="btns-cocina clickable" src="#Atras" 
               position="0.5 1 3" rotation="-90 180 0" scale="0 0 0" visible="false"
               onclick="irA('#img_pasillo', 'btns-pasillo')">
        <a-text value="Volver al Pasillo" align="center" position="0 0.8 0" scale="0.5 0.5 0.5"></a-text>
      </a-image>

      <a-image class="btns-comedor clickable" src="#Atras" 
               position="0 1 3" rotation="-90 180 0" scale="0 0 0" visible="false"
               onclick="irA('#img_cocina', 'btns-cocina')">
        <a-text value="Volver a Cocina" align="center" position="0 0.8 0" scale="0.5 0.5 0.5"></a-text>
      </a-image>

      <a-image class="btns-sala clickable" src="#Atras" 
               position="0 1 3" rotation="-90 180 0" scale="0 0 0" visible="false"
               onclick="irA('#img_pasillo', 'btns-pasillo')">
        <a-text value="Volver al Pasillo" align="center" position="0 0.8 0" scale="0.5 0.5 0.5"></a-text>
      </a-image>

    </a-scene>

    <script>
      function irA(destinoID, claseAMostrar) {
        const sky = document.querySelector('#escena-360');
        sky.setAttribute('src', destinoID);

        const todosLosBotones = document.querySelectorAll('.clickable');
        todosLosBotones.forEach(btn => {
          btn.setAttribute('visible', 'false');
          btn.setAttribute('scale', '0 0 0');
        });

        const botonesNuevos = document.querySelectorAll('.' + claseAMostrar);
        botonesNuevos.forEach(btn => {
          btn.setAttribute('visible', 'true');
          btn.setAttribute('scale', '1 1 1');
        });
      }

      function toggleFullScreen() {
        const scene = document.querySelector('a-scene');
        if (!document.fullscreenElement) {
          if (scene.requestFullscreen) scene.requestFullscreen();
          else if (scene.webkitRequestFullscreen) scene.webkitRequestFullscreen();
        } else {
          if (document.exitFullscreen) document.exitFullscreen();
        }
      }
    </script>
  </body>
</html>
